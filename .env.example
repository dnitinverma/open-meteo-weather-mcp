# Port for the HTTP server (POST /mcp, GET /health)
PORT=3001
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Max real requests to Open-Meteo per UTC day; after that only cached data is served
DAILY_UPSTREAM_LIMIT=9000
# POST /mcp requests per IP per minute (429 above this)
RATE_LIMIT_PER_MINUTE=60
# Reverse-proxy hops to trust for the client IP. Render/Railway: 1. Local: 0
TRUST_PROXY=0
# Optional comma-separated Host allow-list (also applies to /health), e.g. weather-mcp.example.com
ALLOWED_HOSTS=
