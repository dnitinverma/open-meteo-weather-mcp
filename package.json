{
  "name": "open-meteo-weather-mcp-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-Meteo weather MCP App: tools with interactive UI views for Claude, ChatGPT and other MCP Apps hosts.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "views",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n views,server -c blue,green \"npm run dev -w views\" \"npm run dev -w server\"",
    "build": "npm run build -w views && npm run build -w server",
    "start": "npm run start -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke -w server",
    "preview:views": "npm run preview -w views"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
